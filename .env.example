# Copy to .env and fill only credentials you have explicitly obtained.
# Never add wallet private keys or seed phrases to this application.
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
# Notifications default to DRY_RUN. LIVE requires both explicit settings below
# and valid credentials. DISABLED suppresses notifications and dry-run logs.
TELEGRAM_MODE=DRY_RUN
TELEGRAM_LIVE_ENABLED=false

# Read-only discovery defaults
# Optional authenticated OpenSea Drops API. Discovery is disabled without a key.
# Optional Hunter chain names; the Drops adapter maps bnb->bsc and Solana mainnet->solana.
# Leave blank to request all chains supported by OpenSea Drops.
OPENSEA_API_KEY=
# Optional wallet-scoped OpenSea eligibility token. Create a short-lived
# token with read:eligibility in OpenSea settings; never paste it into chat.
# Pin it to the exact public address selected in Hunter. No SIWE signing flow
# or wallet-key handling is performed by Hunter.
OPENSEA_WALLET_JWT=
OPENSEA_WALLET_ADDRESS=
OPENSEA_CHAINS=
# Comma-separated subset of: bnb,ethereum,base,solana,robinhood
ENABLED_CHAINS=bnb,ethereum,base,solana,robinhood
SCAN_INTERVAL_MINUTES=15
MAX_CONCURRENT_SCANS=3
EVM_LOOKBACK_BLOCKS=500
# Configure RPC URLs from your node/provider account. Public Solana and official
# Robinhood endpoints are defaults; public endpoints can be rate-limited.
BNB_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
SOLANA_RPC_URL=
# Maximum network + rent + Metaplex Core protocol fee in the self-created
# asset preview. This is a SOL-denominated cap, not a USD conversion.
CORE_ASSET_PREVIEW_MAX_LAMPORTS=5000000
SOLANA_DAS_RPC_URL=
ROBINHOOD_RPC_URL=
# Optional Etherscan V2 indexed-log/source fallback for Ethereum (1) and Base
# (8453) only. BNB Chain should use a log-capable BNB_RPC_URL provider instead.
# Keep any API key in this local .env file; never paste it into chat or commit it.
ETHERSCAN_API_KEY=
ETHERSCAN_LOGS_API_URL=https://api.etherscan.io/v2/api
# Optional Blockscout-compatible API base URLs for source verification/ABI reads.
BNB_EXPLORER_API_URL=
ETHEREUM_EXPLORER_API_URL=
BASE_EXPLORER_API_URL=
ROBINHOOD_EXPLORER_API_URL=
# Optional candidate mint addresses supplied by a separate Solana indexer/source.
SOLANA_MINT_CANDIDATES=
# Optional known MPL Core Candy Machine account addresses for read-only config inspection.
SOLANA_CANDY_MACHINE_CANDIDATES=
DATABASE_PATH=data/nft_hunter.sqlite3
DASHBOARD_PORT=8767
LOG_LEVEL=INFO

